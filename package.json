{
  "name": "next-tab-group",
  "version": "1.0.0",
  "description": "Cycle between tab groups, collect tabs into one group, rotate the workspace layout, and deduplicate tabs.",
  "main": "main.js",
  "scripts": {
    "lint": "eslint . --max-warnings=0",
    "dev": "node esbuild.config.mjs",
    "build": "npm run lint && tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "test:typecheck": "tsc -noEmit -p tsconfig.test.json"
  },
  "keywords": [
    "obsidian",
    "plugin",
    "tab-groups",
    "navigation",
    "cycling"
  ],
  "author": "notuntoward",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^22.12.0",
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "@typescript-eslint/parser": "^8.60.1",
    "@vitest/ui": "^4.1.10",
    "builtin-modules": "3.2.0",
    "esbuild": "^0.28.0",
    "eslint": "^9.39.4",
    "eslint-plugin-obsidianmd": "^0.3.0",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "obsidian": "latest",
    "tslib": "2.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.60.1",
    "vitest": "^4.1.10"
  }
}
